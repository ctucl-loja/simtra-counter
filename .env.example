# ── Backend (simtra-bus-manager) ──────────────────────────────────────────────
# IP de la Raspberry Pi donde corre simtra-bus-manager. Solo la base: el código
# agrega /api/passenger. No usar localhost si corre en otra Raspberry.
SIMTRA_BACKEND_URL=http://192.168.1.50:8000
HTTP_TIMEOUT=3.0

# Puerta que se envía en el campo "door" (el backend usa FRONT por defecto)
DOOR=FRONT
DIRECTION_ENTRY=ENTRY
DIRECTION_EXIT=EXIT

# ── Sensores (S1..S4, separados por coma) ─────────────────────────────────────
SALIDA_SIDE=S2
INGRESO_SIDE=S1,S3,S4

# ── Tiempos (segundos) ────────────────────────────────────────────────────────
EVENT_BEEP_DURATION=0.2
TIME_COOLDOWN=0.2
LINGER_THRESHOLD=1.5
LINGER_BEEP_DURATION=0.1
LINGER_BEEP_PERIOD=0.4

# ── Cola local de eventos no enviados ─────────────────────────────────────────
# Ruta relativa a la carpeta del proyecto, o absoluta
LOCAL_DB_PATH=passenger_events.sqlite3
PENDING_SYNC_INTERVAL=5
